{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/story-data-analyze/method.schema.json",
  "title": "Promotable analysis method",
  "type": "object",
  "required": [
    "method_id", "version", "title", "scope", "problem", "method_steps",
    "required_inputs", "decision_rules", "limitations", "sources", "status"
  ],
  "properties": {
    "method_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "title": {"type": "string", "minLength": 1},
    "scope": {"oneOf": [{"type": "object"}, {"type": "array"}, {"type": "string"}]},
    "problem": {"type": "string", "minLength": 1},
    "method_steps": {"type": "array", "minItems": 1},
    "required_inputs": {"type": "array", "minItems": 1},
    "decision_rules": {"type": "array", "minItems": 1},
    "limitations": {"type": "array", "minItems": 1},
    "sources": {"type": "array", "minItems": 1},
    "status": {"enum": ["ACTIVE", "EXPERIMENTAL", "DEPRECATED"]},
    "supersedes": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}@[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    }
  },
  "additionalProperties": true
}
