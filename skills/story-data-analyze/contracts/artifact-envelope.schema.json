{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/story-data-analyze/artifact-envelope.schema.json",
  "title": "Immutable workflow artifact envelope",
  "type": "object",
  "required": [
    "schema_version", "run_id", "kind", "attempt", "created_at",
    "producer", "prior_artifact_sha256", "payload_sha256", "payload"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string"},
    "kind": {"type": "string"},
    "attempt": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string"},
    "producer": {"type": "string", "minLength": 1},
    "prior_artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {}
  },
  "additionalProperties": false
}
