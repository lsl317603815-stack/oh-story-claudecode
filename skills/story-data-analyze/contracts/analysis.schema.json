{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/story-data-analyze/analysis.schema.json",
  "title": "Metric-tree analysis",
  "type": "object",
  "required": [
    "overall_status", "sample_size", "strong_conclusion", "causal_attribution",
    "sample_metric_id", "sample_evidence_refs", "metric_tree_coverage", "anomalies",
    "hypotheses", "evidence_refs", "anomaly_rule_evidence", "linked_metric_checks",
    "primary_constraint", "primary_constraint_node", "change_assessments",
    "input_artifact_hashes"
  ],
  "properties": {
    "overall_status": {"enum": ["改善", "恶化", "无明显变化", "样本不足", "数据未覆盖改动", "样本受自访污染", "IMPROVED", "DEGRADED", "NO_CLEAR_CHANGE", "SAMPLE_INSUFFICIENT", "CHANGE_NOT_COVERED", "SELF_VISIT_CONTAMINATED"]},
    "sample_size": {"type": "integer", "minimum": 0},
    "strong_conclusion": {"type": "boolean"},
    "causal_attribution": {"type": "boolean"},
    "sample_metric_id": {"type": "string", "minLength": 1},
    "sample_evidence_refs": {"type": "array", "minItems": 1},
    "metric_tree_coverage": {"type": "object", "required": ["checked_nodes", "missing_nodes", "missing_node_reasons"]},
    "anomalies": {"type": "array", "items": {"$ref": "#/$defs/anomaly"}},
    "hypotheses": {"type": "array", "items": {"type": "object"}},
    "evidence_refs": {"type": "array", "minItems": 1},
    "anomaly_rule_evidence": {"type": "array", "minItems": 1},
    "linked_metric_checks": {"type": "array", "minItems": 1},
    "primary_constraint": {"type": "string", "minLength": 1},
    "primary_constraint_node": {"type": "string", "minLength": 1},
    "change_assessments": {
      "type": "array",
      "items": {"$ref": "#/$defs/changeAssessment"}
    },
    "input_artifact_hashes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
  },
  "$defs": {
    "factSelector": {
      "type": "object",
      "required": ["metric_id", "dimensions"],
      "properties": {"metric_id": {"type": "string"}, "dimensions": {"type": "object"}}
    },
    "changeAssessment": {
      "type": "object",
      "required": [
        "change_id", "status", "direction", "coverage_status", "version_status",
        "evaluated_metric_ids", "evidence_refs", "rationale"
      ],
      "properties": {
        "change_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["改善", "恶化", "无明显变化", "样本不足", "数据未覆盖改动", "样本受自访污染", "IMPROVED", "DEGRADED", "NO_CLEAR_CHANGE", "SAMPLE_INSUFFICIENT", "CHANGE_NOT_COVERED", "SELF_VISIT_CONTAMINATED"]},
        "direction": {"enum": ["UP", "DOWN", "FLAT", "MIXED", "UNKNOWN"]},
        "coverage_status": {"enum": ["NOT_COVERED", "PARTIAL_DAY_COVERED", "FULL_DAY_COVERED"]},
        "version_status": {"enum": ["VERIFIED", "UNVERIFIED", "MISMATCH"]},
        "evaluated_metric_ids": {"type": "array", "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "anomaly": {
      "type": "object",
      "required": [
        "metric_id", "baseline", "current", "delta", "effect_size", "direction",
        "baseline_fact", "current_fact", "threshold_method", "threshold_result",
        "evidence_refs", "neighbors_checked"
      ],
      "properties": {
        "metric_id": {"type": "string"},
        "baseline": {"type": "number"}, "current": {"type": "number"},
        "delta": {"type": "number"}, "effect_size": {"type": "number"},
        "direction": {"enum": ["UP", "DOWN", "FLAT", "MIXED"]},
        "baseline_fact": {"$ref": "#/$defs/factSelector"},
        "current_fact": {"$ref": "#/$defs/factSelector"},
        "threshold_result": {"enum": ["TRIGGERED", "NOT_TRIGGERED", "INCONCLUSIVE"]},
        "neighbors_checked": {"type": "array", "minItems": 1}
      }
    }
  },
  "additionalProperties": true
}
