{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/story-data-analyze/report.schema.json",
  "title": "Final supervised report payload",
  "type": "object",
  "required": ["format", "report", "approved_claim_ids", "input_artifact_hashes"],
  "properties": {
    "format": {"const": "markdown"},
    "report": {"type": "string", "minLength": 1},
    "approved_claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "input_artifact_hashes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
  },
  "additionalProperties": true
}
