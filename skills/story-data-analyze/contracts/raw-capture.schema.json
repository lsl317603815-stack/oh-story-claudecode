{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/story-data-analyze/raw-capture.schema.json",
  "title": "Raw capture receipt",
  "type": "object",
  "required": [
    "status", "source_files", "source_hashes", "capture_mode", "work_id",
    "run_scope_sha256"
  ],
  "properties": {
    "status": {"enum": ["OK", "PARTIAL", "LOGIN_INVALID", "CORRUPT"]},
    "source_files": {"type": "array", "items": {"type": "string"}},
    "source_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "capture_mode": {"enum": ["platform_pull", "frozen_snapshot"]},
    "work_id": {"type": ["string", "integer"]},
    "run_scope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshot_file": {"type": "string"},
    "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshot_date": {"type": "string", "format": "date"},
    "data_until": {"type": "string", "format": "date"},
    "pulled_at": {"type": "string"},
    "login_status": {"enum": ["AUTHENTICATED", "NOT_APPLICABLE", "LOGIN_INVALID"]},
    "endpoint_status": {"type": "object", "minProperties": 1},
    "required_endpoint_names": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "usable_fields": {"type": "array", "items": {"type": "string"}},
    "snapshot_metadata_verified": {"type": "boolean"},
    "work_identity_status": {"enum": ["VERIFIED_SOURCE", "VERIFIED_FROZEN_REGISTRY"]},
    "identity_evidence_files": {"type": "array", "items": {"type": "string"}},
    "identity_evidence_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
  },
  "additionalProperties": true
}
