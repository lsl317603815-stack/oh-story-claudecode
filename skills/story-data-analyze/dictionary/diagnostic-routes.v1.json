  "anomaly_gate_stack": [
    {
      "order": 0, "gate": "data_quality", "rule": "时效、完整、合法、同步、版本覆盖和口径可比门先行。",
      "pass": "affected quality metrics are valid or explicitly isolated", "fail": "受影响分支只报数据异常/未覆盖，不诊断正文"
    },
    {
      "order": 1, "gate": "denominator", "rule": "比率必须有原始分子/分母，并展示绝对人数。",
      "zero_sample": "denominator=0 => not_computable; numerator=0 and denominator>0 => observed zero, still apply sample/baseline gates",
      "small_sample": {"lt_30": "样本不足；只报人数和方向，禁止文本归因", "30_to_99": "最多方向性；需人数/比率同向且重复窗口一致", "gte_100": "可进入区间/MDE检验，但不自动得出因果"}
    },
    {
      "order": 2, "gate": "historical_baseline", "rule": "只使用同书/同故事、同口径、同更新/推荐阶段的有效点。",
      "baseline_size": {"gte_14": "使用最近28个可比点的中位数/MAD或合适控制限", "7_to_13": "临时提醒，不下稳健统计结论", "lt_7": "只报绝对变化与改前快照"},
      "robust_count_alert": "abs(x-median) > max(3*1.4826*MAD, historical_abs_daily_change_P95, 2 persons)",
      "mad_zero": "use IQR/control chart suitable for count distribution or absolute-only reporting; never divide by zero"
    },
    {
      "order": 3, "gate": "effect_size", "rule": "计数同时报绝对差和分母变化；比率同时报 numerator/denominator、Δpp、置信区间和预先 MDE。",
      "ratio_tests": {"small_samples": "Wilson/exact interval plus Fisher exact for two independent groups when assumptions hold", "large_samples": "two-proportion difference interval; p-value alone is insufficient"},
      "mde_rule": "MDE must be declared before seeing the result; absent MDE => describe detectable difference, not business importance"
    },
    {
      "order": 4, "gate": "continuity_and_multiplicity", "rule": "至少近3个可比点有2个同向，或两个非重叠 cohort/窗口同向。扫描多章节使用复现要求，正式检验可用 BH-FDR。",
      "single_point": "L1 reminder only unless it is a validated data incident"
    },
    {
      "order": 5, "gate": "upstream_and_guardrails", "rule": "检查上游规模、渠道换血、更新/推荐阶段、并发改动及下游护栏。",
      "causal_language": "观察数据默认上限是 association/hypothesis；无随机实验或可信准实验不写‘证明修改导致’"
    }
  ],
