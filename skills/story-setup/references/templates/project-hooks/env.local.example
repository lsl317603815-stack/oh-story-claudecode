# .story/.env.local — 本机私有创作扩展配置（请勿提交到公开 Git 仓库）
# 复制到 <书目录>/.story/.env.local 后按需填写；留空项对应钩子会自动静默跳过。

# 导出 EPUB / 全本 TXT 时的作者署名（可选）
STORY_AUTHOR=""

# 朱雀 PDF 台账归属特征词（可选；留空时自动从 追踪/_tracking-state.json 提取主角名与书名）
STORY_ZHUQUE_MARK=""

# 去 AI 味语料池目录（可选；留空时仅在本机存在默认语料目录时才写入）
STORY_DESLOP_CORPUS_POOL=""

# 正文自动导出并镜像同步到已挂载的 NAS 根目录（例如 /Volumes/MyNAS；留空跳过）
STORY_NAS_ROOT=""
# 可选：自定义 NAS 下的相对子目录（默认 小说/<书目录名>）
STORY_NAS_PROSE_SUBDIR=""

# 有声书成品同步配置（方式一：直接指定已挂载目录；方式二：macOS Keychain 免交互 SMB 自动挂载）
STORY_AUDIOBOOK_NAS_ROOT=""
STORY_AUDIOBOOK_NAS_HOST=""
STORY_AUDIOBOOK_NAS_USER=""
STORY_AUDIOBOOK_NAS_SHARE=""
STORY_AUDIOBOOK_NAS_MOUNT=""
STORY_AUDIOBOOK_NAS_DIR=""
